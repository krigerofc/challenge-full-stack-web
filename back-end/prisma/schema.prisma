datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id                Int      @id @default(autoincrement())
  fullName          String
  email             String   @unique
  ra                String   @unique
  cpf               String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}